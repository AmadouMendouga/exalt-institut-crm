# DATABASE_URL: PostgreSQL connection string used by SQLAlchemy/Alembic.
# Matches the local docker-compose.yml Postgres service by default.
DATABASE_URL="postgresql://crm:crm@localhost:5434/service_crm"

# JWT_SECRET: Long random string used to sign session tokens. Generate one with:
# python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET="change-me-to-a-long-random-string"

# ADMIN_EMAIL / ADMIN_PASSWORD: Credentials for the admin account created by
# the seed script (`python -m app.seed`). Change the password after first login in production.
ADMIN_EMAIL="admin@service-crm.local"
ADMIN_PASSWORD="change-me"

# PORT: Port the FastAPI server listens on.
PORT=8787

PUBLIC_APP_URL="https://exalt-beauty.up.railway.app"
# Disable in the web service when using a separate automation worker.
AUTOMATION_ENABLED=true
